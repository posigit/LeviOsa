{
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "AUTH_URL": "https://leviosa.davincci.workers.dev",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BLp-3WS6ePZequp6-TXyUfpvU8k92Ke18WqZyHpCZhZIiUIrtsUdbSxchAIMaw0yiIcT9HWFBQqw0I5ApHm1qBM"
  },
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leviosa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference for ISR/revalidate. `service` MUST match `name` above.
      // See https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "leviosa"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4e1e0c162b714b8f9068b1477304a7f0"
    }
  ],
  "observability": {
    "enabled": true
  }
}
